# ─── Core & Platform ────────────────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ─── Backend API (Express + MongoDB) ──────────────────────────────────────────
MONGODB_URI=""
JWT_SECRET=""
CORS_ORIGIN="http://localhost:3000,https://monopolous.vercel.app"
PORT=3001

# ─── Frontend & Base Integration ─────────────────────────────────────────────
VITE_API_URL=""
VITE_BASE_BUILDER_CODE=""
ADMIN_WALLET_ADDRESS=""
VITE_ADMIN_WALLET_ADDRESS=""
VITE_BASE_NOTIFICATIONS_API_KEY=""
BASE_NOTIFICATIONS_API_KEY=""

# ─── Arc Testnet (ARC Protocol Agents) ───────────────────────────────────────
VITE_ARC_RPC_KEY=""
ARC_RPC_URL=""
VITE_ARC_AGENT_WALLETS=""

# ─── ARC Autonomy Control Plane (Server-Side) ───────────────────────────────
ARC_EXECUTOR_ENABLED="true"
ARC_AUTONOMY_ENABLED="true"
ARC_AUTONOMY_INTERVAL_MS="60000"
ARC_AUTONOMY_MAX_ACTIONS_PER_TICK="1"
ARC_AUTONOMY_TRANSFER_AMOUNT="5"
ARC_AUTONOMY_DRY_RUN="false"
ARC_AUTONOMY_MAX_USDC_PER_TX="25"
ARC_AUTONOMY_MAX_USDC_PER_DAY="5"
ARC_AUTONOMY_COOLDOWN_SECONDS="90"
ARC_AUTONOMY_GLOBAL_MAX_USDC_PER_DAY="50"
ARC_AUTONOMY_CIRCUIT_BREAKER_FAILED_TICKS="5"
ARC_AUTONOMY_RECIPIENT_REPEAT_LIMIT="5"
ARC_CONFIRMATION_REQUIREMENT="1"
ARC_WORKER_TOKEN=""
VITE_ENABLE_CLIENT_ADK="false"

# ─── Circle Test API Keys ───────────────────────────────────────────────────
CIRCLE_TEST_API_KEY=""
CIRCLE_TEST_CLIENT_KEY=""
CIRCLE_KIT_KEY=""
